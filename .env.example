# StockSage 2.0 — Environment Variables
# Copy this file to .env and fill in your API keys.
# Never commit the actual .env file to Git.

# ── Application ────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:3000

# Per-IP rate limit applied to all routes (slowapi syntax).
RATE_LIMIT=120/minute

# ── Database ───────────────────────────────────────────────────
# TimescaleDB / PostgreSQL connection URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stocksage
# Set true for local dev to auto-create tables on startup.
# Leave false in production and run `alembic upgrade head` instead.
DB_AUTO_CREATE=false

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_PRICE=300
CACHE_TTL_SENTIMENT=1800
CACHE_TTL_MACRO=86400

# ── External APIs ──────────────────────────────────────────────
# NewsAPI — https://newsapi.org/register
NEWS_API_KEY=

# FRED (Federal Reserve Economic Data) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage (optional premium data) — https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=

# ── Machine Learning ───────────────────────────────────────────
# Path to the trained TFT checkpoint (relative to project root)
TFT_CHECKPOINT_PATH=models/tft_checkpoint.ckpt
# FinBERT model — automatically downloaded from HuggingFace on first run
FINBERT_MODEL=ProsusAI/finbert
# Compute device: "cpu" for local, "cuda" on Modal GPU
DEVICE=cpu

# ── Modal.com (GPU inference deployment) ───────────────────────
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
